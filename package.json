{
  "name": "slashvibe-mcp",
  "version": "0.8.18",
  "mcpName": "io.github.vibecodinginc/vibe",
  "description": "Presence + messaging for terminal coding agents (Claude Code, Codex, Cursor) — the /vibe kernel",
  "main": "index.js",
  "bin": {
    "slashvibe-mcp": "cli.js",
    "vibe-setup": "setup.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "VIBE_SETUP_NO_AUTORUN=1 VIBE_HOME=\"$(mktemp -d)\" node --test tools/*.test.js",
    "test:context": "VIBE_SETUP_NO_AUTORUN=1 VIBE_HOME=\"$(mktemp -d)\" node --test tools/_work-context.test.js",
    "tokens:sync": "node scripts/sync-room-tone-tokens.js",
    "pack:check": "node scripts/check-pack-closure.js",
    "prepack": "node scripts/sync-versions.js && node scripts/sync-room-tone-tokens.js && node scripts/check-pack-closure.js",
    "version": "node scripts/sync-versions.js && git add server.json",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test:pack": "node --test test/pack-artifact.test.mjs",
    "test:release": "node scripts/release-conformance.mjs",
    "test:parity": "node scripts/version-parity.mjs"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "vibe",
    "social",
    "developer-tools",
    "ai",
    "anthropic",
    "multi-agent",
    "collaboration"
  ],
  "author": "Seth Goldstein <seth@slashvibe.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VibeCodingInc/vibe-mcp.git"
  },
  "homepage": "https://github.com/VibeCodingInc/vibe-mcp#readme",
  "bugs": {
    "url": "https://github.com/VibeCodingInc/vibe-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },

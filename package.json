{
  "name": "slashvibe-mcp",
  "version": "0.8.28",
  "mcpName": "io.github.vibecodinginc/vibe",
  "description": "Telepathic messaging between people, from inside their coding agent sessions (Claude Code, Codex, Cursor)",
  "main": "index.js",
  "bin": {
    "slashvibe-mcp": "cli.js",
    "vibe-draft": "draft-cli.js",
    "vibe-setup": "setup.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "VIBE_SETUP_NO_AUTORUN=1 VIBE_HOME=\"$(mktemp -d)\" node --test tools/*.test.js",
    "pack:check": "node scripts/check-pack-closure.js",
    "prepack": "node scripts/sync-versions.js && node scripts/check-pack-closure.js",
    "version": "node scripts/sync-versions.js && git add server.json",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test:pack": "node --test test/pack-artifact.test.mjs",
    "test:release": "node scripts/release-conformance.mjs",
    "test:parity": "node scripts/version-parity.mjs"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "messaging",
    "developer-tools",
    "ai",
    "agents"
  ],
  "author": "Seth Goldstein <seth@slashvibe.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VibeCodingInc/vibe-mcp.git"
  },
  "homepage": "https://github.com/VibeCodingInc/vibe-mcp#readme",
  "bugs": {
    "url": "https://github.com/VibeCodingInc/vibe-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "README.md",
    "hosts/vibe-command.md",
    "hooks/arrival-hook.cjs",
    "actor-session.js",
    "arrival.js",
    "arrival-hook-settings.js",
    "auth-store.js",
    "cli.js",
    "config.js",
    "crypto.js",
    "draft-cli.js",
    "hook-cli.js",
    "host.js",
    "incoming.js",
    "index.js",
    "oauth-callback.js",
    "presence.js",
    "protocol/handle.js",
    "session-start-hook-settings.js",
    "session-start-hook.cjs",
    "setup.js",
    "store/api.js",
    "store/index.js",
    "store/local.js",
    "tools/_shared.js",
    "tools/_work-context.js",
    "tools/deliver.js",
    "tools/drafts.js",
    "tools/init.js",
    "tools/people.js",
    "tools/start.js",
    "tools/thread.js",
    "tools/token.js",
    "vibe-home.js"
  ]
}
